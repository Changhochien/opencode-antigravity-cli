{
  "name": "opencode-antigravity-cli",
  "version": "0.1.0",
  "description": "Use the authenticated Antigravity CLI as an OpenCode agent with models in OpenChamber's model picker.",
  "type": "module",
  "license": "MIT",
  "author": "Changhochien",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Changhochien/opencode-antigravity-cli.git"
  },
  "homepage": "https://github.com/Changhochien/opencode-antigravity-cli#readme",
  "bugs": "https://github.com/Changhochien/opencode-antigravity-cli/issues",
  "keywords": ["opencode", "openchamber", "antigravity", "agy", "plugin", "subagent"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-antigravity-agent": "./bin/install-agent.mjs"
  },
  "files": ["dist", "bin", "agents", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": { "@opencode/plugin": ">=2.0.16 <3" },
  "devDependencies": {
    "@opencode/plugin": "2.0.16",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
